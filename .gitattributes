# 默认：所有文本文件用 LF 存储，检出时按平台自动转换
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则双击运行报错
*.bat text eol=crlf
*.cmd text eol=crlf

# C 源码保持原样交给 git 自动判断
*.c   text
*.h   text

# 二进制文件不做任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.7z   binary
*.exe  binary
*.dll  binary
*.o    binary
*.axf  binary
*.hex  binary
*.bin  binary
